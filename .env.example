MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# GoLand API / migration run configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=bili_app
DB_PASSWORD=change-me
DB_NAME=bili_support
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Generate a random secret locally; do not commit the actual value.
JWT_SECRET=
JWT_ISSUER=bili-support
JWT_TTL=2h

# Required by the Agent API.
# Independent key: standard Base64 of 32 cryptographically random bytes.
# Never reuse JWT_SECRET. Missing or invalid configuration stops API startup.
# Configure in GoLand; this file is not automatically loaded.
APPEAL_CONFIRMATION_KEY_BASE64=
APPEAL_CONFIRMATION_ISSUER=video-support-agent-appeal
APPEAL_CONFIRMATION_AUDIENCE=video-support-agent-appeal-create

# Empty means no trusted proxy.
# Configure only verified proxy IPs or dedicated trusted CIDRs.
TRUSTED_PROXIES=

# LLM configuration for the Go API process.
# Explicitly configure the service/model combination validated for this project.
# Planner and Answer use separate clients with the same configuration.
# Configure in GoLand; this file is not automatically loaded.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=30s

# Shared Elasticsearch configuration for API and Worker.
# Configure in each GoLand Run Configuration.
# Go processes do not automatically load this file.
ES_URL=http://127.0.0.1:9200
ES_INDEX_ALIAS=rule_chunks_current
ES_TIMEOUT=5s

# Shared Embedding configuration for API and Worker.
# Both processes must use the same pinned model contract.
# Go processes do not automatically load this file.
EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_MODEL_DIGEST=7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
EMBEDDING_DIMENSIONS=1024
EMBEDDING_CONTEXT_LENGTH=8192
EMBEDDING_TIMEOUT=60s

# Milvus API endpoint, not the health endpoint on port 9091.
MILVUS_URL=http://127.0.0.1:19530
MILVUS_DATABASE=default
MILVUS_COLLECTION_ALIAS=rule_chunks_vector_current
MILVUS_TIMEOUT=5s

KAFKA_BROKERS=127.0.0.1:19092
KAFKA_CLIENT_ID=knowledge-worker
KAFKA_CONNECT_TIMEOUT=5s
KAFKA_REQUEST_TIMEOUT=10s
KAFKA_DELIVERY_TIMEOUT=30s
KAFKA_SHUTDOWN_TIMEOUT=30s

# Stable consumer groups shared by instances of the same Worker deployment.
KNOWLEDGE_SOURCE_GROUP=knowledge-index-worker-v1
KNOWLEDGE_RETRY_GROUP=knowledge-index-retry-worker-v1

# Shared by API and Worker.
# Obtain from SELECT @@server_uuid on the intended source MySQL.
# Required; do not use a random UUID or copy one from another environment.
KNOWLEDGE_SOURCE_SERVER_UUID=

# Worker only: maximum reserved generation target pairs.
# For an existing database, match its persisted nonzero generation_limit.
KNOWLEDGE_GENERATION_LIMIT=100

# Worker only: resolved relative to the project working directory.
KNOWLEDGE_ES_DEFINITION=deploy/elasticsearch/rule-chunks-v1.json

# Observability is disabled by default.
OBS_ENABLED=false
OBS_SERVICE_NAME=video-support-agent
OBS_OTLP_ENDPOINT=http://127.0.0.1:4318
OBS_SAMPLE_RATIO=1

# API: 127.0.0.1:9464
# Worker on the same host: override with 127.0.0.1:9465
OBS_METRICS_ADDR=127.0.0.1:9464

# Keep metrics loopback-only unless deployment explicitly permits otherwise.
OBS_METRICS_ALLOW_NON_LOOPBACK=false

# Container deployment overrides.
# These addresses must be reachable from Docker containers.
CONTAINER_EMBEDDING_URL=http://host.docker.internal:11434
CONTAINER_LLM_BASE_URL=

# Set only after inspecting the dedicated Compose network.
# Empty means forwarded client IP headers are not trusted.
CONTAINER_TRUSTED_PROXIES=

# Required by the combined application deployment.
# Supply private values locally; never commit real credentials.
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Worker lifecycle probes; local access only by default.
# Containers must explicitly override with 0.0.0.0:8081.
WORKER_PROBE_ADDR=127.0.0.1:8081

# Container observability is opt-in.
CONTAINER_OBS_ENABLED=false

# Required when CONTAINER_OBS_ENABLED=true.
# Supply an HTTP(S) OTLP endpoint reachable from API and Worker containers.
CONTAINER_OBS_OTLP_ENDPOINT=