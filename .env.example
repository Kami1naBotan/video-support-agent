MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# GoLand API / migration run configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=bili_app
DB_PASSWORD=change-me
DB_NAME=bili_support
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Generate a random secret locally; do not commit the actual value.
JWT_SECRET=
JWT_ISSUER=bili-support
JWT_TTL=2h

# Required by the Agent API.
# Independent key: standard Base64 of 32 cryptographically random bytes.
# Never reuse JWT_SECRET. Missing or invalid configuration stops API startup.
# Configure in GoLand; this file is not automatically loaded.
APPEAL_CONFIRMATION_KEY_BASE64=
APPEAL_CONFIRMATION_ISSUER=video-support-agent-appeal
APPEAL_CONFIRMATION_AUDIENCE=video-support-agent-appeal-create

# Empty means no trusted proxy.
# Configure only verified proxy IPs or dedicated trusted CIDRs.
TRUSTED_PROXIES=

# LLM configuration for the Go API process.
# Explicitly configure the service/model combination validated for this project.
# Planner and Answer use separate clients with the same configuration.
# Configure in GoLand; this file is not automatically loaded.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=30s

# Elasticsearch configuration for the Go API process.
# Configure these variables in GoLand's API Run Configuration.
# The Go program does not automatically load this file.
ES_URL=http://127.0.0.1:9200
ES_INDEX_ALIAS=rule_chunks_current
ES_TIMEOUT=5s

# Embedding configuration for the Go API process.
# Configure these values in GoLand's API Run Configuration.
# The Go program does not automatically load this file.
EMBEDDING_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_MODEL_DIGEST=7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
EMBEDDING_DIMENSIONS=1024
EMBEDDING_CONTEXT_LENGTH=8192
EMBEDDING_TIMEOUT=60s

# Milvus API endpoint, not the health endpoint on port 9091.
MILVUS_URL=http://127.0.0.1:19530
MILVUS_DATABASE=default
MILVUS_COLLECTION_ALIAS=rule_chunks_vector_current
MILVUS_TIMEOUT=5s