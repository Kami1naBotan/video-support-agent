MYSQL_ROOT_PASSWORD=change-me
MYSQL_PASSWORD=change-me

# GoLand API / migration run configuration
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=bili_app
DB_PASSWORD=change-me
DB_NAME=bili_support
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Generate a random secret locally; do not commit the actual value.
JWT_SECRET=
JWT_ISSUER=bili-support
JWT_TTL=2h

# Empty means no trusted proxy.
# Configure only verified proxy IPs or dedicated trusted CIDRs.
TRUSTED_PROXIES=

# LLM configuration for the Go API process.
# Configure these variables in GoLand's API Run Configuration.
# The Go program does not automatically load this file.
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_TIMEOUT=30s